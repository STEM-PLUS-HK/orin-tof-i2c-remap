[Unit]
Description=ToF simplest: rename from config, poke pinmux, hold XSHUT HIGH
After=dev-i2c-1.device
Wants=dev-i2c-1.device
After=multi-user.target
Conflicts=tof-i2c-switcher.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/orin_nano_i2c_switcher/tof_i2c_switcher_simple.py -c /etc/orin_nano_i2c_switcher/config.json
Restart=no
User=root
Group=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
