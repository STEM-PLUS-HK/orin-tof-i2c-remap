[Unit]
Description=XSHUT pinmux poke (header pin 29 / PQ.05 as GPIO)
# JP6.2 boots with pin 29 muxed as input; the ToF switcher cannot drive
# XSHUT until this register write happens. Dies every reboot, hence this unit.
Before=tof-i2c-switcher.service

[Service]
Type=oneshot
ExecStart=/usr/bin/busybox devmem 0x2430068 w 0x8
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
