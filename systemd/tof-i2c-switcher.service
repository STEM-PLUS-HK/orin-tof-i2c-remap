[Unit]
Description=ToF XSHUT I2C address switcher (VL53 remapper)
Documentation=file:///opt/orin_nano_i2c_switcher/README.md
# Wait for the I2C adapter device node used in config.json (default bus 1).
After=dev-i2c-1.device
Wants=dev-i2c-1.device
# Fall back if the .device unit name differs across JetPack versions.
After=multi-user.target
Conflicts=tof-i2c-switcher-simple.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/orin_nano_i2c_switcher/tof_i2c_switcher.py monitor --config /etc/orin_nano_i2c_switcher/config.json
Restart=on-failure
RestartSec=3
# Keep GPIO / I2C ownership for the process lifetime.
User=root
Group=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
